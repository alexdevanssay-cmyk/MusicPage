<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macos/Runner/DebugProfile.entitlements
  ───────────────────────────────────────
  Sandbox entitlements for Debug and Profile builds.
  macOS requires explicit entitlements for every hardware resource;
  without audio-input the app silently receives no microphone data.
-->
<plist version="1.0">
<dict>
    <!-- Microphone access -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- App Sandbox (required for Mac App Store) -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Allow outbound network connections to the local Python backend -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- JIT: needed by the Flutter debug runner -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Unsigned executable memory (Flutter engine) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Disable library validation (Flutter plugins) -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
